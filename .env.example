# Firebase web configuration — Pomodoro Bird.
#
# Copy this file to `.env.local` and fill in the real values from the Firebase
# console (Project settings → Your apps → Web app) for the project
# `bird-pomodoro-timer`.
#
# SECURITY (rules.md §6): NEVER commit `.env.local` or real values. This file
# is committed with variable NAMES ONLY and empty placeholders. When these are
# unset, the app stays fully local-only (no accounts, no cloud sync).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
